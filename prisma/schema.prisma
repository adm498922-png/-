datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// 앱 전역 설정: 쿠팡파트너스 / Threads 개발자 앱 키 (값은 암호화되어 저장됨)
model Settings {
  id                  String   @id @default("singleton")
  coupangAccessKeyEnc String?
  coupangSecretKeyEnc String?
  threadsAppId        String?
  threadsAppSecretEnc String?
  threadsRedirectUri  String?
  openaiApiKeyEnc     String?
  naverClientId       String?
  naverClientSecretEnc String?
  // 인스타그램 프로필 자동 불러오기(Business Discovery)용
  igBusinessAccountId String?
  igAccessTokenEnc    String?
  // 판매일보 가져오기에서 마지막으로 쓴 제목 줄 (JSON 배열 문자열)
  salesSheetHeader    String?
  // 공구 제안 DM 고정 틀
  dmTemplate          String?
  autoDailyPostEnabled Boolean @default(false)
  autoDailyPostIncludeProducts Boolean @default(false)
  updatedAt           DateTime @updatedAt
}

model ThreadsAccount {
  id               String   @id @default(cuid())
  label            String // 예: "1번 계정"
  threadsUserId    String   @unique
  username         String?
  accessTokenEnc   String
  tokenExpiresAt   DateTime?
  connectedAt      DateTime @default(now())
  isActive         Boolean  @default(true)

  postTargets      PostTarget[]
}

model CoupangLink {
  id            String   @id @default(cuid())
  productName   String?
  originalUrl   String
  shortUrl      String
  imageUrl      String?
  createdAt     DateTime @default(now())

  // AI(Sora) 생성 홍보 영상: 생성 요청 시 GENERATING → 완료되면 READY(videoUrl 채워짐) / 실패 시 FAILED
  videoStatus   String?
  videoJobId    String?
  videoUrl      String?
  videoError    String?

  posts         Post[]
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model Post {
  id            String     @id @default(cuid())
  body          String
  commentBody   String?
  coupangLinkId String?
  coupangLink   CoupangLink? @relation(fields: [coupangLinkId], references: [id])
  status        PostStatus @default(DRAFT)
  scheduledAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  targets       PostTarget[]
}

enum PostTargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  COMMENTING
  DONE
  FAILED
}

model PostTarget {
  id                String            @id @default(cuid())
  postId            String
  post              Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  threadsAccountId  String
  threadsAccount    ThreadsAccount    @relation(fields: [threadsAccountId], references: [id], onDelete: Cascade)
  body              String? // 이 계정에만 적용할 문구 (없으면 Post.body 사용)
  commentBody       String? // 이 계정에만 적용할 첫 댓글 (없으면 Post.commentBody 사용)
  status            PostTargetStatus  @default(PENDING)
  threadsMediaId    String?
  threadsPermalink  String?
  commentMediaId    String?
  errorMessage      String?
  publishedAt       DateTime?

  stats             PostStat[]

  @@unique([postId, threadsAccountId])
}

model PostStat {
  id           String   @id @default(cuid())
  postTargetId String
  postTarget   PostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)
  views        Int      @default(0)
  likes        Int      @default(0)
  replies      Int      @default(0)
  reposts      Int      @default(0)
  quotes       Int      @default(0)
  capturedAt   DateTime @default(now())

  @@index([postTargetId, capturedAt])
}

// ─────────────────────────────────────────────────────────────
// 공동구매 크리에이터 관리
// ─────────────────────────────────────────────────────────────

enum CreatorStatus {
  LEAD      // 후보 (아직 연락 안 함)
  CONTACTED // 컨택중
  CONFIRMED // 확정 (진행하기로 합의)
  ONGOING   // 공구 진행중
  DONE      // 진행 완료
  HOLD      // 보류
  REJECTED  // 거절/무응답
}

model Creator {
  id             String        @id @default(cuid())
  name           String // 활동명 또는 이름
  platform       String        @default("INSTAGRAM") // INSTAGRAM / THREADS / YOUTUBE / TIKTOK / BLOG / BAND / ETC
  handle         String? // @아이디
  profileUrl     String?
  followers      Int?
  following      Int? // 이 사람이 팔로우하는 수 (인스타 프로필의 '팔로우')
  category       String? // 육아, 주방, 리빙 …
  contactType    String? // 오픈채팅 / 이메일 / DM / 전화
  contact        String?
  feeKrw         Int? // 진행비(원)
  commissionRate Float? // 수수료 %
  status         CreatorStatus @default(LEAD)
  rating         Int? // 1~5, 내 평가
  isBusiness     Boolean? // 사업자 여부 (사업자면 3.3% 원천징수 없이 세금계산서)
  tags           String? // 쉼표로 구분
  memo           String?
  lastContactAt  DateTime?

  // 인스타그램에서 자동으로 불러온 정보
  bio            String? // 프로필 소개글
  linkInBio      String? // 프로필에 걸어둔 링크 (인포크링크·링크트리 등 — 공구 일정이 여기 있다)
  profileImageUrl String?
  postCount      Int?
  avgLikes       Int? // 최근 게시물 평균 좋아요
  avgComments    Int? // 최근 게시물 평균 댓글
  engagementRate Float? // 참여율 %  (평균 반응 ÷ 팔로워 × 100)
  igUserId       String?
  syncedAt       DateTime? // 마지막으로 불러온 시각

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  deals          Deal[]
  calendarEvents CalendarEvent[]
  campaignAssignments CampaignAssignment[]

  @@index([status])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  brand          String?
  imageUrl       String? // 대표 이미지
  images         String? // 나머지 이미지 주소들. 쉼표로 구분해 저장
  retailPrice    Int? // 소비자가(원) = 공구 판매가
  supplyPrice    Int? // 공급가(원) — 셀러/벤더 공급가 중 나와 관련된 쪽
  commissionRate Float? // 크리에이터에게 줄 수수료 %
  memo           String?
  isActive       Boolean  @default(true) // 지금 공구 가능한 상품인지

  // 업체 제안서에서 가져온 항목들. 업체마다 양식이 달라 자유 텍스트로 둔다.
  vendorCompany       String? // 업체(브랜드사) 상호명
  vendorContact       String? // 담당자 이름
  vendorPhone         String?
  vendorEmail         String?
  shippingFee         String? // 배송비 (예: "개당 4,000원 · 도서산간 별도")
  returnPolicy        String? // 교환/반품 정책
  asInfo              String? // A/S 정보
  settlementSchedule  String? // 정산 일정
  origin              String? // 원산지
  composition         String? // 구성품
  material            String? // 소재/재질
  sizeWeight          String? // 크기/중량
  noticeExtra         String? // 그 외 상품정보고시 등 자유 메모

  // 원본 제안서 파일 — DM 보낼 때 다운로드해서 직접 첨부할 수 있게 보관
  proposalFileUrl     String?
  proposalFileName    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deals          Deal[]
}

enum DealStatus {
  PLANNED  // 예정
  ONGOING  // 진행중
  CLOSED   // 종료
  CANCELED // 취소
}

// 크리에이터 한 명이 상품 하나로 진행한 공구 1건
model Deal {
  id          String     @id @default(cuid())
  creatorId   String
  creator     Creator    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id])
  productName String? // 상품 목록에 없는 상품을 직접 적은 경우
  status      DealStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  unitsSold   Int? // 판매 수량
  revenue     Int? // 매출(원)

  // 정산 — 판매일보에서 쓰던 항목들
  commissionRate  Float? // 인플루언서 수수료율 %
  salesCommission Int? // 인플루언서 판매 수수료(원, 세전)
  contentFee      Int? // 콘텐츠 제작비(원)
  settlement      Int? // 인플루언서 실 지급 정산금(원, 3.3% 뗀 뒤)
  agencyRate      Float? // 우리 수수료율 %
  agencyFee       Int? // 우리 수수료(원)
  settleDueDate   DateTime? // 정산 예정일
  settledAt       DateTime? // 정산 완료일

  // 진행 체크
  linkSent         Boolean @default(false) // 링크 전달
  taxReported      Boolean @default(false) // 세금신고
  statementIssued  Boolean @default(false) // 간이지급명세서

  memo        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([creatorId])
}

// ─────────────────────────────────────────────────────────────
// 일정 · 할일
// ─────────────────────────────────────────────────────────────

enum CalendarEventKind {
  EVENT // 일정
  TODO  // 할일
}

model CalendarEvent {
  id         String            @id @default(cuid())
  kind       CalendarEventKind @default(EVENT)
  title      String
  date       DateTime // 시작일(할일이면 마감일로 씀)
  endDate    DateTime? // 여러 날짜에 걸친 일정일 때
  done       Boolean           @default(false) // 할일 완료 여부
  memo       String?
  creatorId  String? // 특정 크리에이터와 관련된 일정이면 연결
  creator    Creator?          @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// 캠페인 — 광고 캠페인 / 공구·협업 캠페인을 만들어 여러 크리에이터에게
// 한 번에 제안(매칭 + DM 발송)하는 기능. 공구 상품(Product)·공구 기록(Deal)과는
// 별개로, "이 건으로 크리에이터를 모집한다"는 캠페인 자체를 관리한다.
// ─────────────────────────────────────────────────────────────

enum CampaignType {
  AD     // 광고 캠페인
  COLLAB // 공구/협업
}

enum CampaignStatus {
  DRAFT     // 준비 중
  ACTIVE    // 진행 중
  COMPLETED // 완료
}

model Campaign {
  id       String         @id @default(cuid())
  type     CampaignType   @default(AD)
  brand    String
  name     String
  category String?
  desc     String?

  // 광고 캠페인 전용
  microTarget  Int?
  macroTarget  Int?
  megaTarget   Int?
  budget       Int?
  period       String?
  productShip  Boolean?
  secondaryUse Boolean?

  // 공구/협업 캠페인 전용
  salePrice      Int?
  listPrice      Int?
  commissionRate Float?
  targetQty      Int?
  collabStart    DateTime?
  collabEnd      DateTime?
  promo          String?

  status    CampaignStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  assignments CampaignAssignment[]
}

enum DmSendStatus {
  PENDING
  SENT
}

// 캠페인에 배정된 크리에이터 한 명 = 매칭 결과이자 DM 발송 큐의 한 줄
model CampaignAssignment {
  id         String       @id @default(cuid())
  campaignId String
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status     DmSendStatus @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime     @default(now())

  @@unique([campaignId, creatorId])
  @@index([campaignId])
  @@index([creatorId])
}

// 사장님이 저장해두고 골라 쓰는 DM 문구 (캠페인 DM 발송 큐 전용, 여러 개 저장 가능)
model DmTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
