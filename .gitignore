# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local sqlite database
*.db
*.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts

# 로컬 개발 중 업로드된 첨부 파일 (DB 옆 assets 폴더)
/prisma/assets/
/prisma/media/
